@model IEnumerable<PocketCardsUnlimited.Models.SportsCard>

@{
    ViewData["Title"] = "My Collection";

    var cards = Model?.ToList() ?? new List<PocketCardsUnlimited.Models.SportsCard>();

    int totalCards = cards.Count;
    decimal totalValue = cards.Sum(c => c.EstimatedValue);

    string currentSearch = ViewData["CurrentFilter"]?.ToString() ?? "";
    bool isSearching = !string.IsNullOrWhiteSpace(currentSearch);
}

<style>
    .collection-header {
        background: linear-gradient(135deg, #162447, #1f4068);
        color: white;
        padding: 35px;
        border-radius: 15px;
        margin-bottom: 30px;
    }

    .collection-header h1 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .collection-header p {
        color: #dce6f2;
        margin-bottom: 0;
    }

    .summary-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.2s ease;
        height: 100%;
    }

    .summary-card:hover {
        transform: translateY(-4px);
    }

    .summary-card h5 {
        color: #6c757d;
        font-weight: 600;
    }

    .summary-number {
        font-size: 2.3rem;
        font-weight: 700;
    }

    .collection-panel {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .collection-table {
        margin-bottom: 0;
    }

    .collection-table thead {
        background-color: #162447;
        color: white;
    }

    .collection-table thead th {
        background-color: #162447;
        color: white;
        padding: 16px;
        font-weight: 600;
        white-space: nowrap;
    }

    .collection-table tbody td {
        padding: 15px;
        vertical-align: middle;
    }

    .collection-table tbody tr:hover td {
        background-color: #f0f5fa;
    }

    .player-name {
        font-weight: 600;
        color: #162447;
    }

    .sport-badge {
        background-color: #e8f0fe;
        color: #1f4068;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-block;
    }

    .value-text {
        color: #198754;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .action-buttons .btn {
        border-radius: 8px;
    }

    .section-heading {
        color: #162447;
        font-weight: 700;
    }

    .custom-button {
        border-radius: 9px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .search-input {
        border-radius: 9px 0 0 9px;
    }

    .collection-footer {
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 15px;
    }
</style>

<div class="container mt-4 mb-5">

    <!-- Collection Header -->
    <div class="collection-header shadow-sm">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h1>My Sports Card Collection</h1>

                <p>
                    Organize, manage, and track your favorite sports cards.
                </p>
            </div>

            <div>
                <span class="badge bg-light text-dark fs-6 p-3">
                    Pocket Cards Unlimited
                </span>
            </div>

        </div>

    </div>

    <!-- Collection Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-6">

            <div class="card summary-card shadow-sm">

                <div class="card-body p-4">

                    <h5>Total Sports Cards</h5>

                    <div class="summary-number text-primary">
                        @totalCards
                    </div>

                    <p class="text-muted mb-0">
                        Cards currently displayed
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card summary-card shadow-sm">

                <div class="card-body p-4">

                    <h5>Estimated Collection Value</h5>

                    <div class="summary-number text-success">
                        @totalValue.ToString("C")
                    </div>

                    <p class="text-muted mb-0">
                        Total estimated value of displayed cards
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2 flex-wrap mb-4">

        <a asp-controller="SportsCards"
           asp-action="Create"
           class="btn btn-success custom-button">

            + Add New Card

        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary custom-button">

            Back to Home

        </a>

    </div>

    <!-- Search Panel -->
    <div class="card collection-panel shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="section-heading mb-3">
                Search Your Collection
            </h4>

            <p class="text-muted">
                Search by player name, sport, team, manufacturer, or year.
            </p>

            <p class="text-muted small">
                Partial searches are supported. For example,
                <strong>Mich*</strong> or
                <strong>*Jordan</strong>
                will find Michael Jordan.
            </p>

            <form asp-controller="SportsCards"
                  asp-action="Index"
                  method="get">

                <div class="input-group">

                    <input type="text"
                           name="searchString"
                           value="@currentSearch"
                           class="form-control search-input"
                           placeholder="Search your sports cards..."
                           aria-label="Search sports cards" />

                    <button type="submit"
                            class="btn btn-primary">

                        Search

                    </button>

                    <a asp-controller="SportsCards"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Clear

                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- Search Results -->
    @if (isSearching)
    {
        <div class="alert alert-primary shadow-sm">

            Search results for:
            <strong>@currentSearch</strong>

            <br />

            <strong>@totalCards</strong> card(s) found.

        </div>
    }

    <!-- Collection Table -->
    <div class="card collection-panel shadow-sm">

        <div class="card-body p-0">

            <div class="p-4 border-bottom">

                <h4 class="section-heading mb-1">
                    Collection Inventory
                </h4>

                <p class="text-muted mb-0">
                    View and manage your sports card inventory.
                </p>

            </div>

            @if (cards.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover collection-table">

                        <thead>

                            <tr>
                                <th>Player</th>
                                <th>Sport</th>
                                <th>Team</th>
                                <th>Year</th>
                                <th>Manufacturer</th>
                                <th>Estimated Value</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var card in cards)
                            {
                                <tr>

                                    <td class="player-name">
                                        @card.PlayerName
                                    </td>

                                    <td>
                                        <span class="sport-badge">
                                            @card.Sport
                                        </span>
                                    </td>

                                    <td>
                                        @(card.Team ?? "N/A")
                                    </td>

                                    <td>
                                        @card.Year
                                    </td>

                                    <td>
                                        @(card.Manufacturer ?? "N/A")
                                    </td>

                                    <td class="value-text">
                                        @card.EstimatedValue.ToString("C")
                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <a asp-action="Details"
                                               asp-route-id="@card.Id"
                                               class="btn btn-sm btn-outline-info">

                                                Details

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@card.Id"
                                               class="btn btn-sm btn-outline-warning">

                                                Edit

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@card.Id"
                                               class="btn btn-sm btn-outline-danger">

                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4">

                    @if (isSearching)
                    {
                        <div class="alert alert-info mb-0">

                            <p class="mb-2">
                                No sports cards matched your search for
                                <strong>@currentSearch</strong>.
                            </p>

                            <p class="mb-0">
                                Try another search or click Clear
                                to display your full collection.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">

                            No sports cards found in your collection.
                            Click <strong>Add New Card</strong>
                            to get started.

                        </div>
                    }

                </div>
            }

        </div>

    </div>

    <!-- Footer -->
    <div class="collection-footer text-center">

        Pocket Cards Unlimited |
        Sports Card Collection Management System

    </div>

</div>