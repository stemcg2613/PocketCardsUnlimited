@model IEnumerable<PocketCardsUnlimited.Models.SportsCard>

@{
    ViewData["Title"] = "My Collection";

    var cards = Model?.ToList() ?? new List<PocketCardsUnlimited.Models.SportsCard>();
    int totalCards = cards.Count;
    decimal totalValue = cards.Sum(c => c.EstimatedValue);
}

<div class="container mt-4">

    <h1 class="fw-bold mb-3">My Sports Card Collection</h1>

    <p class="text-muted">
        View, manage, and organize your sports card collection.
    </p>

    <!-- Collection Summary -->
    <div class="row mb-4">

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h5>Total Sports Cards</h5>

                    <h2 class="text-primary fw-bold">
                        @totalCards
                    </h2>

                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h5>Estimated Collection Value</h5>

                    <h2 class="text-success fw-bold">
                        @totalValue.ToString("C")
                    </h2>

                </div>
            </div>
        </div>

    </div>

    <!-- Actions -->
    <div class="d-flex gap-2 mb-4">

        <a asp-controller="SportsCards"
           asp-action="Create"
           class="btn btn-success">
            + Add New Card
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Home
        </a>

    </div>

    <!-- Search -->
    <form asp-controller="SportsCards"
          asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">

            <input type="text"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Search by player, sport, team, manufacturer, or year" />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="SportsCards"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>

        </div>

    </form>

    <!-- Collection Table -->
    @if (cards.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Player</th>
                        <th>Sport</th>
                        <th>Team</th>
                        <th>Year</th>
                        <th>Manufacturer</th>
                        <th>Estimated Value</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var card in cards)
                    {
                        <tr>
                            <td>@card.PlayerName</td>
                            <td>@card.Sport</td>
                            <td>@card.Team</td>
                            <td>@card.Year</td>
                            <td>@card.Manufacturer</td>
                            <td>@card.EstimatedValue.ToString("C")</td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@card.Id"
                                       class="btn btn-sm btn-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@card.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@card.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">

            No sports cards found in your collection.

            Click <strong>Add New Card</strong> to get started.

        </div>
    }

</div>