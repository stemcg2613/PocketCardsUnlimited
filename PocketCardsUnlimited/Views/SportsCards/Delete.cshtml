@model PocketCardsUnlimited.Models.SportsCard

@{
    ViewData["Title"] = "Delete Card";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h1 class="fw-bold mb-2">Delete Sports Card</h1>

            <p class="text-muted mb-4">
                Are you sure you want to remove this card from your collection?
            </p>

            <div class="card shadow-sm">

                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Confirm Delete</h5>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        This action cannot be undone.
                    </div>

                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th>Player Name</th>
                                <td>@Model.PlayerName</td>
                            </tr>

                            <tr>
                                <th>Sport</th>
                                <td>@Model.Sport</td>
                            </tr>

                            <tr>
                                <th>Team</th>
                                <td>@Model.Team</td>
                            </tr>

                            <tr>
                                <th>Manufacturer</th>
                                <td>@Model.Manufacturer</td>
                            </tr>

                            <tr>
                                <th>Year</th>
                                <td>@Model.Year</td>
                            </tr>

                            <tr>
                                <th>Card Number</th>
                                <td>@Model.CardNumber</td>
                            </tr>

                            <tr>
                                <th>Condition</th>
                                <td>@Model.Condition</td>
                            </tr>

                            <tr>
                                <th>Estimated Value</th>
                                <td>@Model.EstimatedValue.ToString("C")</td>
                            </tr>
                        </tbody>
                    </table>

                    <form asp-controller="SportsCards"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Card
                            </button>

                            <a asp-controller="SportsCards"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>